# Synthetic demonstration only. Copy to .env; generate secrets with scripts/setup.py.
DATABASE_URL=sqlite:///./data/app.db
MOCK_DATABASE_URL=sqlite:///./data/mock.db
CHECKPOINT_URL=sqlite:///./data/checkpoints.db
APP_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-with-a-local-demo-password
PROVIDER_MODE=fixture
DEMO_MODE=true
SESSION_SECONDS=1800
APPROVAL_SECONDS=900
OPENAI_API_KEY=
TEXT_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
JUDGE_MODEL=gpt-4.1-mini
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# Zero rates mean unavailable pricing for live calls, not free calls.
PRICING_VERSION=operator-unconfigured
EMBEDDING_USD_PER_MILLION=0
SPEECH_USD_PER_MINUTE=0
TTS_USD_PER_MILLION_CHARACTERS=0
# Explicit operator budget is required before any real provider request.
# Reservations are retained after failures and must conservatively cover a call.
LIVE_TOTAL_BUDGET_USD=0
LIVE_CALL_RESERVATION_USD=0
MOCK_URL=http://127.0.0.1:8001
MCP_URL=http://127.0.0.1:8002/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_VIEWER_URL=http://localhost:16686
DATA_DIR=./data
QUEUE_LEASE_SECONDS=15
MAX_ATTEMPTS=3
MAX_TOOL_CALLS=24
WORKFLOW_TIMEOUT_SECONDS=1800
RETENTION_DAYS=30
ALERT_STALL_SECONDS=120
ALERT_FAILURE_COUNT=3
ALERT_COST_USD=1
ALLOW_FAULT_INJECTION=true
# setup.py appends a generated POSTGRES_PASSWORD for Compose.
